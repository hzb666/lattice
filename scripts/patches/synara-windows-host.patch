diff --git a/apps/web/src/lib/latticeWorkspaceRefresh.ts b/apps/web/src/lib/latticeWorkspaceRefresh.ts
new file mode 100644
--- /dev/null
+++ b/apps/web/src/lib/latticeWorkspaceRefresh.ts
@@ -0,0 +1,55 @@
+import { readEmbedMode } from "../embedMode";
+import { randomUUID } from "./utils";
+
+const REQUEST = "synara:prepare-agent-turn";
+const RESULT = "lattice:prepare-agent-turn-result";
+const TIMEOUT_MS = 30_000;
+
+/** The Windows host must refresh its read-only manuscript mirror before a new turn. */
+export async function prepareLatticeWorkspaceForTurn(): Promise<void> {
+  if (window.parent === window) return;
+  const config = readEmbedMode();
+  if (!config) return;
+  if (!config.hostOrigin) throw new Error("The Lattice project host is unavailable.");
+  const hostOrigin = config.hostOrigin;
+
+  const requestId = randomUUID();
+  await new Promise<void>((resolve, reject) => {
+    const finish = (ok: boolean) => {
+      window.clearTimeout(timer);
+      window.removeEventListener("message", onMessage);
+      if (ok) resolve();
+      else reject(new Error("The Lattice project could not be refreshed before sending."));
+    };
+    const onMessage = (event: MessageEvent) => {
+      if (
+        event.source !== window.parent ||
+        event.origin !== hostOrigin ||
+        !event.data ||
+        typeof event.data !== "object"
+      ) return;
+      const response = event.data as Record<string, unknown>;
+      if (
+        response.type === RESULT &&
+        response.version === 1 &&
+        response.requestId === requestId &&
+        typeof response.ok === "boolean"
+      ) finish(response.ok);
+    };
+    const timer = window.setTimeout(() => finish(false), TIMEOUT_MS);
+    window.addEventListener("message", onMessage);
+    try {
+      window.parent.postMessage(
+        {
+          type: REQUEST,
+          version: 1,
+          requestId,
+          workspaceRoot: config.workspaceRoot,
+        },
+        hostOrigin,
+      );
+    } catch {
+      finish(false);
+    }
+  });
+}

