+function batchHostManuscripts(files: readonly string[]): string[][] {
+  const batches: string[][] = [];
+  let batch: string[] = [];
+  let size = 0;
+  for (const file of files) {
+    const argumentSize = file.length + 80;
+    if (argumentSize > MAX_WINDOWS_GIT_ARGUMENT_CHARS) {
+      throw new Error("A manuscript path exceeds the Windows checkpoint command limit.");
+    }
+    if (batch.length > 0 && size + argumentSize > MAX_WINDOWS_GIT_ARGUMENT_CHARS) {
+      batches.push(batch);
+      batch = [];
+      size = 0;
+    }
+    batch.push(file);
+    size += argumentSize;
+  }
+  if (batch.length > 0) batches.push(batch);
+  return batches;
