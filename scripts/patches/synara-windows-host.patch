@@ -0,0 +1,97 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { prepareLatticeWorkspaceForTurn } from "./latticeWorkspaceRefresh";
+
+const mocks = vi.hoisted(() => ({ readEmbedMode: vi.fn() }));
+vi.mock("../embedMode", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("../embedMode")>()),
+  readEmbedMode: mocks.readEmbedMode,
+}));
+
+const config = {
+  workspaceRoot: "C:/projects/paper",
+  theme: "dark" as const,
+  surface: "chrome" as const,
+  hostOrigin: "http://localhost:1420",
+  locale: "en" as const,
+};
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+  vi.resetAllMocks();
+});
+
+function installFrame() {
+  const frame = new EventTarget() as EventTarget & { parent: object };
+  const postMessage = vi.fn<(message: unknown, targetOrigin: string) => void>();
+  const parent = { postMessage };
+  Object.assign(frame, {
+    parent,
+    setTimeout: globalThis.setTimeout.bind(globalThis),
+    clearTimeout: globalThis.clearTimeout.bind(globalThis),
+  });
+  vi.stubGlobal("window", frame);
+  mocks.readEmbedMode.mockReturnValue(config);
+  return { frame, parent, postMessage };
+}
+
+function deliver(frame: EventTarget, parent: object, origin: string, data: unknown) {
+  frame.dispatchEvent(Object.assign(new Event("message"), { source: parent, origin, data }));
+}
+
+describe("Lattice workspace turn barrier", () => {
+  it("does not wait for a Lattice host outside embed mode", async () => {
+    const { postMessage } = installFrame();
+    mocks.readEmbedMode.mockReturnValue(null);
+    await expect(prepareLatticeWorkspaceForTurn()).resolves.toBeUndefined();
+    expect(postMessage).not.toHaveBeenCalled();
+  });
+
+  it("waits for the correlated host refresh result", async () => {
+    const { frame, parent, postMessage } = installFrame();
+    const pending = prepareLatticeWorkspaceForTurn();
+    const [rawRequest, targetOrigin] = postMessage.mock.calls[0]!;
+    const request = rawRequest as Record<string, unknown>;
+    expect(request).toMatchObject({
+      type: "synara:prepare-agent-turn",
+      version: 1,
+      requestId: expect.any(String),
+      workspaceRoot: config.workspaceRoot,
+    });
+    expect(targetOrigin).toBe(config.hostOrigin);
+
+    deliver(frame, parent, config.hostOrigin, {
+      type: "lattice:prepare-agent-turn-result",
+      version: 1,
+      requestId: "another-turn",
+      ok: true,
+    });
+    deliver(frame, parent, "http://untrusted.test", {
+      type: "lattice:prepare-agent-turn-result",
+      version: 1,
+      requestId: request.requestId,
+      ok: true,
+    });
+    deliver(frame, parent, config.hostOrigin, {
+      type: "lattice:prepare-agent-turn-result",
+      version: 1,
+      requestId: request.requestId,
+      ok: true,
+    });
+
+    await expect(pending).resolves.toBeUndefined();
+  });
+
+  it("fails closed when the host rejects the refresh", async () => {
+    const { frame, parent, postMessage } = installFrame();
+    const pending = prepareLatticeWorkspaceForTurn();
+    const [rawRequest] = postMessage.mock.calls[0]!;
+    const request = rawRequest as Record<string, unknown>;
+    deliver(frame, parent, config.hostOrigin, {
+      type: "lattice:prepare-agent-turn-result",
+      version: 1,
+      requestId: request.requestId,
+      ok: false,
+    });
+    await expect(pending).rejects.toThrow("could not be refreshed");
+  });
+});
