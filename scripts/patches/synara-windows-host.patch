+    for (const entry of await readdir(join(root, relativeFolder), { withFileTypes: true })) {
+      const name = entry.name.normalize("NFKC").toUpperCase();
+      if (
+        name.startsWith(".GIT") ||
+        name.startsWith(".LATTICE-MXC-") ||
+        HOST_PRIVATE_FOLDERS.has(name) ||
+        HOST_PROTECTED_SUFFIX.test(name) ||
+        entry.isSymbolicLink()
+      )
+        continue;
+      const relative = relativeFolder ? `${relativeFolder}/${entry.name}` : entry.name;
+      if (entry.isDirectory()) {
+        folders.push(relative);
+      } else if (entry.isFile() && HOST_MANUSCRIPT_SUFFIX.test(entry.name)) {
+        const file = await lstat(join(root, relative));
+        if (file.isFile() && file.nlink === 1) files.push(relative);
+      }
+    }
+  }
+  return files.sort();
+}
