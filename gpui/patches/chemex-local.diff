+    let above = anchor.origin.y - tooltip_size.height - TOOLTIP_ANCHOR_GAP;
+    let below = anchor.bottom() + TOOLTIP_ANCHOR_GAP;
+    let y = if above >= TOOLTIP_WINDOW_MARGIN {
