+    let bottom_limit = (viewport_size.height - TOOLTIP_WINDOW_MARGIN).max(TOOLTIP_WINDOW_MARGIN);
+    if bounds.right() > right_limit {
+        bounds.origin.x -= bounds.right() - right_limit;
