\ifchemex@verify
  \newwrite\chemex@numbers
  \immediate\openout\chemex@numbers=\jobname.chemex-numbers.dat
  \AtEndDocument{\immediate\closeout\chemex@numbers}
\fi

\def\chemd{\@ifnextchar[{\chemex@chemd}{\chemex@chemddefault}}
\def\chemex@chemddefault#1{%
  \csname chemex_if_mnova:nTF\endcsname{#1}%
    {\chemex@withspectrumoptions{}{#1}}%
    {\chemex@drawing{compound}{#1}\includegraphics}%
}
\def\chemex@chemd[#1]#2{%
  \csname chemex_if_mnova:nTF\endcsname{#2}%
    {\chemex@withspectrumoptions{#1}{#2}}%
    {\chemex@drawing{#1}{#2}\includegraphics}%
}
\def\chemn{\@ifnextchar[{\chemex@chemn}{\chemex@chemndefault}}
\def\chemex@chemndefault#1{\chemex@withspectrumoptions{}{#1}}
\def\chemex@chemn[#1]#2{\chemex@withspectrumoptions{#1}{#2}}
\def\chemex@drawing#1#2#3{%
  \stepcounter{chemex@drawing}%
  \ifchemex@verify
    \immediate\write\chemex@figures{\string\chemex@drawrequest{#1}{\unexpanded{#2}}}%
  \else\ifchemex@prepared\else
    \immediate\write\chemex@figures{\string\chemex@drawrequest{#1}{\unexpanded{#2}}}%
  \fi\fi
  \ifchemex@discovery\else
    \edef\chemex@index{\arabic{chemex@drawing}}%
    \ifchemex@numbering
      \ifcsname chemex@fields@\chemex@index\endcsname
        \setbox\chemex@fieldbox=\hbox{\csname chemex@fields@\chemex@index\endcsname}%
      \else
        \PackageError{chemex}{Drawing registration is missing}{Run the Chemex build from the manuscript source.}%
      \fi
    \else
      \ifcsname chemex@counter@\chemex@index\endcsname
        \edef\chemex@requested{#1}%
        \edef\chemex@registered{\csname chemex@counter@\chemex@index\endcsname}%
        \ifx\chemex@requested\chemex@registered\else
          \PackageError{chemex}{Drawing counter changed between build passes}{Keep CDXML references and their counters consistent.}%
        \fi
        \ifcsname chemex@fields@\chemex@index\endcsname
          \setbox\chemex@fieldbox=\hbox{\csname chemex@fields@\chemex@index\endcsname}%
        \else
          \PackageError{chemex}{Drawing registration is missing}{Run the Chemex build from the manuscript source.}%
        \fi
        #3{\csname chemex@asset@\chemex@index\endcsname}%
      \else
        \PackageError{chemex}{Drawing registration is missing}{Run the Chemex build from the manuscript source.}%
      \fi
    \fi
  \fi
}
\def\chemex@withspectrumoptions#1#2{%
  \begingroup
  \chemex@parse@spectrum{#1}%
  \chemex@spectrum{\chemex@parsed@spec}{\chemex@parsed@cmpd}%
    {\chemex@parsed@x}{\chemex@parsed@y}{\chemex@parsed@size}{#2}{\includegraphics}%
  \endgroup
}
\def\chemex@spectrum#1#2#3#4#5#6#7{%
  \stepcounter{chemex@drawing}%
  \ifchemex@verify
    \immediate\write\chemex@figures{\string\chemex@spectrumrequest{#1}{#2}{#3}{#4}{#5}{\unexpanded{#6}}}%
  \else\ifchemex@prepared\else
    \immediate\write\chemex@figures{\string\chemex@spectrumrequest{#1}{#2}{#3}{#4}{#5}{\unexpanded{#6}}}%
  \fi\fi
  \ifchemex@discovery\else
    \edef\chemex@index{\arabic{chemex@drawing}}%
    \ifchemex@numbering\else
      \ifcsname chemex@spectrum@\chemex@index\endcsname
        \edef\chemex@requested{#1}%
        \edef\chemex@registered{\csname chemex@spectrum@\chemex@index\endcsname}%
        \ifx\chemex@requested\chemex@registered\else
          \PackageError{chemex}{Mnova spectrum changed between build passes}{Keep the spectrum index consistent.}%
        \fi
        \edef\chemex@registeredcompound{\csname chemex@compound@\chemex@index\endcsname}%
        \edef\chemex@registeredx{\csname chemex@x@\chemex@index\endcsname}%
        \edef\chemex@registeredy{\csname chemex@y@\chemex@index\endcsname}%
        \edef\chemex@registeredsize{\csname chemex@size@\chemex@index\endcsname}%
        \edef\chemex@requestedcompound{#2}%
        \edef\chemex@requestedx{#3}%
        \edef\chemex@requestedy{#4}%
        \edef\chemex@requestedsize{#5}%
        \ifx\chemex@requestedcompound\chemex@registeredcompound\else
          \PackageError{chemex}{Mnova compound changed between build passes}{Keep the compound key consistent.}%
        \fi
        \ifx\chemex@requestedx\chemex@registeredx\else
          \PackageError{chemex}{Mnova formula x changed between build passes}{Keep the formula position consistent.}%
        \fi
        \ifx\chemex@requestedy\chemex@registeredy\else
          \PackageError{chemex}{Mnova formula y changed between build passes}{Keep the formula position consistent.}%
        \fi
        \ifx\chemex@requestedsize\chemex@registeredsize\else
          \PackageError{chemex}{Mnova formula size changed between build passes}{Keep the formula size consistent.}%
        \fi
        \chemex@overlay{#7{\csname chemex@asset@\chemex@index\endcsname}}{#3}{#4}{#5}{\csname chemex@formula@\chemex@index\endcsname}%
      \else
        \PackageError{chemex}{Spectrum registration is missing}{Run the Chemex build from the manuscript source.}%
      \fi
    \fi
  \fi
}

\def\chemex@overlay#1#2#3#4#5{%
  \protected@edef\chemex@formulaValue{#5}%
  \ifx\chemex@formulaValue\@empty
    #1%
  \else
    \setbox\chemex@spectrumbox=\hbox{#1}%
    \chemex@spectrumwidth=\wd\chemex@spectrumbox
    \setbox\chemex@formulabox=\hbox{\fontsize{#4}{#4}\selectfont $\displaystyle \chemex@formulaValue$}%
    \ifdim\wd\chemex@formulabox>\wd\chemex@spectrumbox
      \setbox\chemex@formulabox=\hbox{\resizebox{\wd\chemex@spectrumbox}{!}{\box\chemex@formulabox}}%
    \fi
    \chemex@overlaymax=\ht\chemex@spectrumbox
    \advance\chemex@overlaymax \dp\chemex@spectrumbox
    \chemex@overlayx=\ht\chemex@formulabox
    \advance\chemex@overlayx \dp\chemex@formulabox
    \ifdim\chemex@overlayx>\chemex@overlaymax
      \setbox\chemex@formulabox=\hbox{\resizebox*{!}{\chemex@overlaymax}{\box\chemex@formulabox}}%
    \fi
    \chemex@overlayx=\wd\chemex@spectrumbox
    \multiply\chemex@overlayx #2
    \divide\chemex@overlayx 100
    \chemex@overlaymax=\wd\chemex@spectrumbox
    \advance\chemex@overlaymax -\wd\chemex@formulabox
    \ifdim\chemex@overlayx>\chemex@overlaymax \chemex@overlayx=\chemex@overlaymax\fi
    \chemex@overlaymax=\ht\chemex@spectrumbox
    \advance\chemex@overlaymax \dp\chemex@spectrumbox
    \multiply\chemex@overlaymax #3
    \divide\chemex@overlaymax 100
    \chemex@overlayy=\ht\chemex@spectrumbox
    \advance\chemex@overlayy -\chemex@overlaymax
    \advance\chemex@overlayy -\ht\chemex@formulabox
    \chemex@overlaymax=\dp\chemex@formulabox
    \advance\chemex@overlaymax -\dp\chemex@spectrumbox
    \ifdim\chemex@overlayy<\chemex@overlaymax \chemex@overlayy=\chemex@overlaymax\fi
    \chemex@overlaymax=\ht\chemex@spectrumbox
    \advance\chemex@overlaymax -\ht\chemex@formulabox
    \ifdim\chemex@overlayy>\chemex@overlaymax \chemex@overlayy=\chemex@overlaymax\fi
    \rlap{\box\chemex@spectrumbox}%
    \smash{\rlap{\kern\chemex@overlayx\raise\chemex@overlayy\box\chemex@formulabox}}%
    \kern\chemex@spectrumwidth
  \fi
}

\let\chemex@originalgraphics\Ginclude@graphics
\ExplSyntaxOn
% shortcut: keys stay opaque, add range compression only with parent-child key semantics.
\clist_new:N \l_chemex_list_keys_clist
\int_new:N \l_chemex_list_count_int
\cs_new_protected:Npn \chemex@list #1#2
  {
    \clist_set:Nn \l_chemex_list_keys_clist {#2}
    \int_set:Nn \l_chemex_list_count_int {\clist_count:N \l_chemex_list_keys_clist}
    \int_compare:nNnTF {\l_chemex_list_count_int} = {0}
      {\PackageError{chemex}{Empty~compound~list}{Add~one~or~more~keys~to~the~\\chemex~argument.}}
      {
        \clist_map_indexed_inline:Nn \l_chemex_list_keys_clist
          {
            \tl_if_blank:nTF {##2}
              {\PackageError{chemex}{Empty~compound~key~in~list}{Remove~extra~commas~from~the~\\chemex~argument.}}
              {
                \int_compare:nNnT {##1} > {1}
                  {
                    \int_compare:nNnTF {\l_chemex_list_count_int} = {2}
                      {\ChemexListPairSeparator}
                      {
                        \int_compare:nNnTF {##1} = {\l_chemex_list_count_int}
                          {\ChemexListFinalSeparator}
                          {\ChemexListSeparator}
                      }
                  }
                \chemex@referenceone{#1}{##2}
              }
          }
      }
  }
\tl_new:N \l_chemex_spectrum_spec_tl
\tl_new:N \l_chemex_spectrum_cmpd_tl
\tl_new:N \l_chemex_spectrum_size_tl
\int_new:N \l_chemex_spectrum_x_int
\int_new:N \l_chemex_spectrum_y_int
\keys_define:nn { chemex/spectrum }
  {
    spec .tl_set:N = \l_chemex_spectrum_spec_tl,
    cmpd .tl_set:N = \l_chemex_spectrum_cmpd_tl,
    x .int_set:N = \l_chemex_spectrum_x_int,
    y .int_set:N = \l_chemex_spectrum_y_int,
    size .tl_set:N = \l_chemex_spectrum_size_tl
  }
\cs_new_protected:Npn \chemex@parse@spectrum #1
  {
    \tl_set:Nn \l_chemex_spectrum_spec_tl { 1 }
    \tl_clear:N \l_chemex_spectrum_cmpd_tl
    \int_set:Nn \l_chemex_spectrum_x_int { 50 }
    \int_set:Nn \l_chemex_spectrum_y_int { 15 }
    \tl_set:Nn \l_chemex_spectrum_size_tl { 8pt }
    \tl_if_in:nnTF {#1} { = }
      { \keys_set:nn { chemex/spectrum } {#1} }
      { \tl_if_blank:nF {#1} { \tl_set:Nn \l_chemex_spectrum_spec_tl {#1} } }
    \edef\chemex@parsed@spec{\tl_use:N \l_chemex_spectrum_spec_tl}
    \edef\chemex@parsed@cmpd{\tl_use:N \l_chemex_spectrum_cmpd_tl}
    \edef\chemex@parsed@x{\int_use:N \l_chemex_spectrum_x_int}
    \edef\chemex@parsed@y{\int_use:N \l_chemex_spectrum_y_int}
    \edef\chemex@parsed@size{\tl_use:N \l_chemex_spectrum_size_tl}
  }
\cs_new_protected:Npn \chemex_if_mnova:nTF #1#2#3
  {
    \exp_args:Nne \regex_match:nnTF
      { \.[mM][nN][oO][vV][aA] "? \Z }
      { \tl_to_str:n {#1} }
      {#2}
      {#3}
  }
\cs_set_protected:Npn \Ginclude@graphics #1
  {
    \exp_args:Nne \regex_match:nnTF { \.[cC][dD][xX][mM][lL] "? \Z } { \tl_to_str:n {#1} }
      { \chemex@drawing{compound}{#1}\chemex@originalgraphics }
      {
        \exp_args:Nne \regex_match:nnTF { \.[mM][nN][oO][vV][aA] "? \Z } { \tl_to_str:n {#1} }
          { \chemex@spectrum{1}{}{50}{15}{8pt}{#1}{\chemex@originalgraphics} }
          { \chemex@originalgraphics{#1} }
      }
  }
\ExplSyntaxOff

\makeatother
