\newcommand{\chemex@register}[4]{%
  \expandafter\def\csname chemex@counter@#1\endcsname{#2}%
  \expandafter\def\csname chemex@fields@#1\endcsname{#3}%
  \expandafter\def\csname chemex@asset@#1\endcsname{#4}%
}
\newcommand{\chemex@registerspectrum}[8]{%
  \expandafter\def\csname chemex@spectrum@#1\endcsname{#2}%
  \expandafter\def\csname chemex@asset@#1\endcsname{#3}%
  \expandafter\def\csname chemex@compound@#1\endcsname{#4}%
  \expandafter\def\csname chemex@x@#1\endcsname{#5}%
  \expandafter\def\csname chemex@y@#1\endcsname{#6}%
  \expandafter\def\csname chemex@size@#1\endcsname{#7}%
  \expandafter\def\csname chemex@formula@#1\endcsname{#8}%
}

\newcommand{\chemex@claim}[2]{%
  \@ifundefined{c@#1}{%
    \PackageError{chemex}{Unknown LaTeX counter `#1'}{Define it with \\newcounter before using \\chemex.}%
  }{}%
  \ifcsname chemex@labelcounter@#2\endcsname
    \edef\chemex@labelcounter{\csname chemex@labelcounter@#2\endcsname}%
    \edef\chemex@requestedcounter{#1}%
    \ifx\chemex@labelcounter\chemex@requestedcounter\else
      \PackageError{chemex}{Compound key `#2' uses multiple LaTeX counters}{Use a new key when switching counters.}%
    \fi
  \else
    \expandafter\xdef\csname chemex@labelcounter@#2\endcsname{#1}%
  \fi
}
\newcommand{\chemex@assignfield}[2]{%
  \in@{|}{#2}%
  \ifin@
    \chemex@assignsubfield{#1}#2\chemex@subfieldstop
  \else
    \chemex@assignplainfield{#1}{#2}%
  \fi
}
\newcommand{\chemex@assignplainfield}[2]{%
  \chemex@claim{#1}{#2}%
  \ifcsname chemex@label@#2\endcsname
    \chemex@checknumber{#2}%
  \else
    \refstepcounter{#1}%
    \expandafter\xdef\csname chemex@label@#2\endcsname{\csname the#1\endcsname}%
    \ifchemex@numbering
      \immediate\write\chemex@numbers{\string\chemex@number{#2}{\csname chemex@label@#2\endcsname}}%
    \fi
    \chemex@checknumber{#2}%
  \fi
  \chemex@recordnumber{#2}%
}
\newcommand{\chemex@nextsubletter}[2]{%
  \ifcsname chemex@subletter@#1|#2\endcsname
    \edef\chemex@subletter{\csname chemex@subletter@#1|#2\endcsname}%
  \else
    \ifcsname chemex@subcount@#1\endcsname
      \chemex@subcount=\csname chemex@subcount@#1\endcsname\relax
    \else
      \chemex@subcount=0\relax
    \fi
    \advance\chemex@subcount by 1\relax
    \ifnum\chemex@subcount>26
      \PackageError{chemex}{Too many subcompounds for `#1'}{A parent can have at most 26 lettered subcompounds.}%
      \def\chemex@subletter{?}%
    \else
      \expandafter\xdef\csname chemex@subcount@#1\endcsname{\the\chemex@subcount}%
      \expandafter\xdef\csname chemex@subletter@#1|#2\endcsname{\@alph\chemex@subcount}%
      \edef\chemex@subletter{\csname chemex@subletter@#1|#2\endcsname}%
    \fi
  \fi
}
\def\chemex@assignsubfield#1#2|#3\chemex@subfieldstop{%
  \chemex@assignplainfield{#1}{#2}%
  \chemex@claim{#1}{#2|#3}%
  \ifcsname chemex@label@#2|#3\endcsname
    \chemex@checknumber{#2|#3}%
  \else
    \chemex@nextsubletter{#2}{#3}%
    \expandafter\xdef\csname chemex@label@#2|#3\endcsname{\csname chemex@label@#2\endcsname\chemex@subletter}%
    \ifchemex@numbering
      \immediate\write\chemex@numbers{\string\chemex@number{#2|#3}{\csname chemex@label@#2|#3\endcsname}}%
    \fi
    \chemex@checknumber{#2|#3}%
  \fi
  \chemex@recordnumber{#2|#3}%
}
\newcommand{\chemex@assign}[2]{%
  \chemex@claim{#1}{#2}%
  \ifcsname chemex@label@#2\endcsname\else
    \refstepcounter{#1}%
    \expandafter\xdef\csname chemex@label@#2\endcsname{\csname the#1\endcsname}%
    \ifchemex@numbering
      \immediate\write\chemex@numbers{\string\chemex@number{#2}{\csname chemex@label@#2\endcsname}}%
    \else
      \chemex@checknumber{#2}%
    \fi
  \fi
}
\newcommand{\chemex@assignreference}[2]{%
  \in@{|}{#2}%
  \ifin@
    \chemex@assignfield{#1}{#2}%
  \else
    \chemex@assign{#1}{#2}%
  \fi
}

\newcommand{\chemex@recordnumber}[1]{%
  \ifchemex@verify
    \ifcsname chemex@expected@#1\endcsname
      \ifcsname chemex@recorded@#1\endcsname\else
        \global\expandafter\let\csname chemex@recorded@#1\endcsname\@empty
        \immediate\write\chemex@numbers{\string\chemex@number{#1}{\csname chemex@label@#1\endcsname}}%
      \fi
    \fi
  \fi
}

\newcommand{\chemex@expected}[2]{\expandafter\gdef\csname chemex@expected@#1\endcsname{#2}}
\ifchemex@discovery\else
  \InputIfFileExists{chemex-register.tex}{}{}
\fi
\newcommand{\chemex@checknumber}[1]{%
  \ifcsname chemex@expected@#1\endcsname
    \edef\chemex@actual{\csname chemex@label@#1\endcsname}%
    \edef\chemex@expectedlabel{\csname chemex@expected@#1\endcsname}%
    \edef\chemex@actual{\expandafter\detokenize\expandafter{\chemex@actual}}%
    \edef\chemex@expectedlabel{\expandafter\detokenize\expandafter{\chemex@expectedlabel}}%
    \ifx\chemex@actual\chemex@expectedlabel\else
      \PackageError{chemex}{Compound number for `#1' changed between build passes}{Run the Chemex build again.}%
    \fi
  \fi
}

\def\chemex@default{compound}
\newcommand{\ChemexListSeparator}{, }
\newcommand{\ChemexListPairSeparator}{ and~}
\newcommand{\ChemexListFinalSeparator}{, and~}
\DeclareRobustCommand{\chemex}{\@ifnextchar[{\chemex@reference}{\chemex@reference[compound]}}
\def\chemex@reference[#1]#2{%
  \ifchemex@discovery\else
    \chemex@list{#1}{#2}%
  \fi
}
\def\chemex@referenceone#1#2{%
  \ifchemex@discovery\else
    \edef\chemex@requestedcounter{#1}%
    \ifchemex@numbering
      \ifx\chemex@requestedcounter\chemex@default
        \chemex@claim{#1}{#2}%
        \ifcsname chemex@expected@#2\endcsname
          \csname chemex@expected@#2\endcsname%
        \else
          \ifcsname chemex@label@#2\endcsname
            \csname chemex@label@#2\endcsname%
          \else
            ??%
          \fi
        \fi
      \else
        \chemex@assignreference{#1}{#2}%
        \csname chemex@label@#2\endcsname%
      \fi
    \else
      \ifx\chemex@requestedcounter\chemex@default
        \ifcsname chemex@expected@#2\endcsname
          \chemex@claim{#1}{#2}%
          \csname chemex@expected@#2\endcsname%
        \else
          \chemex@assignreference{#1}{#2}%
          \csname chemex@label@#2\endcsname%
        \fi
      \else
        \chemex@assignreference{#1}{#2}%
        \chemex@recordnumber{#2}%
        \csname chemex@label@#2\endcsname%
      \fi
    \fi
  \fi
}

\ifchemex@numbering
  \newwrite\chemex@numbers
